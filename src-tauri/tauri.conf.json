{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Roan",
  "version": "0.0.13",
  "identifier": "dev.roan",
  "build": {
    "beforeBuildCommand": "npm --prefix web run build",
    "frontendDist": "../web/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Roan",
        "width": 1180,
        "height": 780,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true,
        "center": true,
        "visible": true,
        "decorations": true,
        "theme": "Dark",
        "backgroundColor": "#0B0D10"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "One agent, several machines",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZDNzY2NzNEMEI4MjNEN0IKUldSN1BZSUxQV2QyL0dyaXVzTnR4bURSVkNRZ2RLbjl3UEI5QjlOZEFkb2NiRldITXA3TXB5TlcK",
      "endpoints": [
        "https://github.com/roanh47/Roan/releases/latest/download/latest.json"
      ]
    }
  }
}
